# .config/dunst/dunstrc
[global]
    follow = mouse
    width = (220, 320)
    origin = top-center
    offset = 0x40
    font = Iosevka 10
    markup = full
    format = "<b>%s</b>\n%b"
    padding = 12
    horizontal_padding = 14
    separator_height = 0
    frame_width = 2
    frame_color = "#4f94cd"
    corner_radius = 0
    icon_position = left
    min_icon_size = 32
    max_icon_size = 32
    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_corner_radius = 0
    highlight = "#4f94cd"
    history_length = 20

[urgency_low]
    background = "#181818"
    foreground = "#e4e4ef"
    timeout = 4

[urgency_normal]
    background = "#181818"
    foreground = "#e4e4ef"
    timeout = 6

[urgency_critical]
    background = "#181818"
    foreground = "#f4f4ff"
    frame_color = "#f43841"
    timeout = 0

[osd]
    appname = osd
    format = "%s"
    timeout = 1
    history_ignore = yes

[screenshot]
    appname = screenshot
    min_icon_size = 96
    max_icon_size = 96

[dmoji]
appname = dmoji
history_ignore = yes
