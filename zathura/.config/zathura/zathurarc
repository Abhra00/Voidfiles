set font "Iosevka 10"
set selection-clipboard clipboard
set window-title-basename true
set statusbar-home-tilde true
set adjust-open best-fit
set scroll-step 80
set zoom-step 10
set guioptions "s"
set database sqlite

set default-bg "#181818"
set default-fg "#e4e4ef"
set statusbar-bg "#282828"
set statusbar-fg "#e4e4ef"
set inputbar-bg "#282828"
set inputbar-fg "#f4f4ff"
set notification-bg "#282828"
set notification-fg "#e4e4ef"
set notification-error-bg "#f43841"
set notification-error-fg "#f4f4ff"
set notification-warning-bg "#ffdd33"
set notification-warning-fg "#181818"
set completion-bg "#282828"
set completion-fg "#e4e4ef"
set completion-group-bg "#453d41"
set completion-group-fg "#96a6c8"
set completion-highlight-bg "#4f94cd"
set completion-highlight-fg "#f4f4ff"
set index-bg "#181818"
set index-fg "#e4e4ef"
set index-active-bg "#4f94cd"
set index-active-fg "#f4f4ff"
set render-loading-bg "#181818"
set render-loading-fg "#e4e4ef"
set highlight-color "rgba(255,221,51,0.4)"
set highlight-fg "rgba(255,221,51,0.4)"
set highlight-active-color "rgba(79,148,205,0.5)"

set recolor false
set recolor-keephue true
set recolor-lightcolor "#181818"
set recolor-darkcolor "#e4e4ef"

map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map <C-i> recolor
