# mod and font
set $mod Mod4
font pango:Iosevka 10
floating_modifier $mod
tiling_drag modifier titlebar

# behaviour
force_focus_wrapping yes
workspace_auto_back_and_forth yes

# paths
set $scripts_dir ~/.local/bin

# palette
set $bg #181818
set $bg1 #282828
set $bg2 #453d41
set $fg #e4e4ef
set $fg1 #f4f4ff
set $quartz #95a99f
set $niagara #96a6c8
set $azurite #4f94cd
set $yellow #ffdd33
set $red #f43841
set $green #73c936

# layout and borders
workspace_layout tabbed
default_border normal 0
default_floating_border normal 0
title_align left

client.focused          $azurite $azurite $fg1    $azurite $azurite
client.focused_inactive $bg2     $bg2     $fg     $bg2     $bg2
client.unfocused        $bg1     $bg      $quartz $bg1     $bg1
client.urgent           $red     $red     $fg1    $red     $red
client.placeholder      $bg      $bg      $fg     $bg      $bg
client.background       $bg

# autostart
exec --no-startup-id dbus-update-activation-environment --all
exec --no-startup-id pipewire
exec --no-startup-id $scripts_dir/audio-route
exec --no-startup-id xwallpaper --zoom ~/.local/share/Wallpaper.jpg
exec --no-startup-id picom --config ~/.config/picom/picom.conf
exec --no-startup-id dunst
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1
exec --no-startup-id emacs --daemon
exec_always --no-startup-id xsetroot -cursor_name left_ptr

# apps
bindsym $mod+Return exec --no-startup-id st
bindsym $mod+w exec --no-startup-id firefox
bindsym $mod+Shift+Return exec --no-startup-id nemo
bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+q kill

# utilities
bindsym $mod+Shift+s exec --no-startup-id $scripts_dir/screenshot

# media
bindsym XF86AudioRaiseVolume exec --no-startup-id $scripts_dir/osd volume up
bindsym XF86AudioLowerVolume exec --no-startup-id $scripts_dir/osd volume down
bindsym XF86AudioMute exec --no-startup-id $scripts_dir/osd volume mute
bindsym XF86AudioMicMute exec --no-startup-id $scripts_dir/osd mic
bindsym XF86MonBrightnessUp exec --no-startup-id $scripts_dir/osd brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id $scripts_dir/osd brightness down
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous

# media (no fn)
bindsym $mod+Up exec --no-startup-id $scripts_dir/osd volume up
bindsym $mod+Down exec --no-startup-id $scripts_dir/osd volume down
bindsym $mod+Shift+m exec --no-startup-id $scripts_dir/osd volume mute
bindsym $mod+Ctrl+m exec --no-startup-id $scripts_dir/osd mic
bindsym $mod+Shift+Up exec --no-startup-id $scripts_dir/osd brightness up
bindsym $mod+Shift+Down exec --no-startup-id $scripts_dir/osd brightness down
bindsym $mod+slash exec --no-startup-id playerctl play-pause
bindsym $mod+comma exec --no-startup-id playerctl previous
bindsym $mod+period exec --no-startup-id playerctl next

# Custom demnu menus
bindsym $mod+Ctrl+e exec --no-startup-id $scripts_dir/dmoji
bindsym $mod+Ctrl+b exec --no-startup-id $scripts_dir/batmenu

# focus
bindsym $mod+f focus right
bindsym $mod+b focus left
bindsym $mod+n focus down
bindsym $mod+p focus up
bindsym $mod+a focus parent
bindsym $mod+z focus child

# focus cycle
bindsym $mod+Tab exec --no-startup-id $scripts_dir/lk next
bindsym $mod+Shift+Tab exec --no-startup-id $scripts_dir/lk prev
bindsym $mod+o exec --no-startup-id $scripts_dir/lk next
bindsym $mod+Shift+o exec --no-startup-id $scripts_dir/lk prev

# jump straight to tab N
bindsym $mod+Ctrl+1 exec --no-startup-id $scripts_dir/lk tab 1
bindsym $mod+Ctrl+2 exec --no-startup-id $scripts_dir/lk tab 2
bindsym $mod+Ctrl+3 exec --no-startup-id $scripts_dir/lk tab 3
bindsym $mod+Ctrl+4 exec --no-startup-id $scripts_dir/lk tab 4
bindsym $mod+Ctrl+5 exec --no-startup-id $scripts_dir/lk tab 5
bindsym $mod+Ctrl+6 exec --no-startup-id $scripts_dir/lk tab 6
bindsym $mod+Ctrl+7 exec --no-startup-id $scripts_dir/lk tab 7
bindsym $mod+Ctrl+8 exec --no-startup-id $scripts_dir/lk tab 8
bindsym $mod+Ctrl+9 exec --no-startup-id $scripts_dir/lk tab 9

# move windows
bindsym $mod+Shift+f move right
bindsym $mod+Shift+b move left
bindsym $mod+Shift+n move down
bindsym $mod+Shift+p move up

# layout
bindsym $mod+t layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split
bindsym $mod+Shift+t layout toggle tabbed split
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+m fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# session
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id $scripts_dir/powermenu

# resize
mode "resize" {
    bindsym b resize shrink width 10 px or 10 ppt
    bindsym f resize grow width 10 px or 10 ppt
    bindsym p resize shrink height 10 px or 10 ppt
    bindsym n resize grow height 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym ctrl+g mode "default"
}
bindsym $mod+r mode "resize"

# bar
bar {
    font pango:Iosevka 10
    position bottom
    status_command i3status-rs ~/.config/i3status-rust/config.toml
    colors {
        background $bg
        statusline $fg
        separator $bg2
        focused_workspace $azurite $azurite $fg1
        active_workspace $bg2 $bg2 $fg
        inactive_workspace $bg $bg $quartz
        urgent_workspace $red $red $fg1
    }
}
